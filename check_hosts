#!/bin/bash

verifica_ip() {
    host_name=$1
    ip_local=$2
    dns_server=$3

    ip_dns=$(dig @$dns_server +short "$host_name" | head -n 1)

    if [ "$ip_local" = "$ip_dns" ]
    then
        echo "$host_name OK"
    else
        echo "$host_name INVALID"
    fi
}

while read ip host
do
    verifica_ip "$host" "$ip" "8.8.8.8"
done < /etc/hosts
